<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">
    <AnalogClock
        android:id="@+id/interstellar_clock_analog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/interstellar_preview_description"
        android:dial="@drawable/interstellar_blank"
        android:hand_hour="@drawable/interstellar_blank"
        android:hand_minute="@drawable/interstellar_blank"
        android:hand_second="@drawable/interstellar_analog_seconds_black" />
    <AnalogClock
        android:id="@+id/interstellar_clock_analog_hands"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/interstellar_preview_description"
        android:dial="@drawable/interstellar_blank"
        android:hand_hour="@drawable/interstellar_analog_hour_black"
        android:hand_minute="@drawable/interstellar_analog_minute_black" />
</FrameLayout>
