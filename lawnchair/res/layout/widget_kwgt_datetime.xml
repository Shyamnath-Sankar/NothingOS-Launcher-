<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_black"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_kwgt_datetime_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/kwgt_datetime_preview_description"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/kwgt_datetime_fallback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp">

        <TextClock
            android:id="@+id/kwgt_weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/kwgt_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:format12Hour="hh:mma"
            android:format24Hour="hh:mma"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/dot_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/kwgt_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:format12Hour="MMMM"
            android:format24Hour="MMMM"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/kwgt_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="d"
                android:format24Hour="d"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kwgt_day_suffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
