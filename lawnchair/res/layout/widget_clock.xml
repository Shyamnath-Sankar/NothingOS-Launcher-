<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_black"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_clock_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/clock_preview_description"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="72sp"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="monospace"
        android:format12Hour="@string/clock_format_12"
        android:format24Hour="@string/clock_format_24"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:lineSpacingMultiplier="0.9"
        android:maxLines="2"
        android:padding="0dp"
        android:textColor="@color/widget_ink"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/clock_fallback_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:includeFontPadding="false"
        android:paddingBottom="4dp"
        android:text="@string/clock_fallback_note"
        android:textColor="@color/widget_muted"
        android:textSize="9sp"
        android:visibility="gone" />

</FrameLayout>
