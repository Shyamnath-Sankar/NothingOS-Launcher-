<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <AnalogClock
        android:id="@+id/kwgt_analog5clear_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/kwgt_analog5clear_content_description"
        android:dial="@drawable/dw_analog5clear_dial_white"
        android:hand_hour="@drawable/dw_analog5_hour"
        android:hand_minute="@drawable/dw_analog5_minute_white" />

</FrameLayout>
