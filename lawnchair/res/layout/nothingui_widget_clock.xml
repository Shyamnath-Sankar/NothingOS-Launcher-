<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!--
      The provider replaces this default tile with the stored light/dark surface at runtime, so the
      clock does not depend on system night resource qualifiers. The tile is inset by the root
      padding and has modest rounded corners to pair with the circular battery face. ImageView is
      on the RemoteViews class whitelist; a bare View is not.
    -->
    <ImageView
        android:id="@+id/nothingui_clock_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nothingui_widget_tile_dark"
        android:importantForAccessibility="no" />

    <!--
      A native TextClock, not a hand-painted static time. TextClock follows the system 12/24-hour
      setting, the current timezone and minute ticks without an alarm, wake lock or foreground
      service. The bundled Doto OFL font provides the dot-matrix face.
    -->
    <TextClock
        android:id="@+id/nothingui_clock_time"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="64sp"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/doto_bold"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:textColor="#F2F2F2"
        android:textSize="48sp" />

</FrameLayout>
