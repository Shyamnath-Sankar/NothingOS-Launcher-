<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!--
      The provider swaps this default rounded tile for the stored light/dark surface at runtime.
      ImageView is on the RemoteViews class whitelist; a bare View is not.
    -->
    <ImageView
        android:id="@+id/nothingui_device_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nothingui_widget_tile_dark"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <!-- Left: real app data-volume storage and a bounded genuine progress bar. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nothingui_device_storage_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/doto_regular"
                    android:letterSpacing="0.2"
                    android:maxLines="1"
                    android:text="@string/nothingui_device_storage_label"
                    android:textColor="#B3B3B3"
                    android:textSize="9sp" />

                <!-- The one restrained red accent. -->
                <ImageView
                    android:id="@+id/nothingui_device_accent"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/nothingui_device_accent_dot"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                android:id="@+id/nothingui_device_storage_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/doto_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/nothingui_device_storage_unknown"
                android:textColor="#F2F2F2"
                android:textSize="19sp" />

            <ProgressBar
                android:id="@+id/nothingui_device_storage_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/nothingui_widget_progress_track"
                android:progressTint="@color/nothingui_widget_progress" />

            <TextView
                android:id="@+id/nothingui_device_storage_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/doto_regular"
                android:maxLines="1"
                android:text=""
                android:textColor="#B3B3B3"
                android:textSize="9sp" />
        </LinearLayout>

        <!--
          Right: a short vertical group of clearly-labelled Settings shortcuts. These are action
          pills, never on/off toggles or fabricated connection states.
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nothingui_device_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/nothingui_device_pill_dark"
                android:clickable="true"
                android:fontFamily="@font/doto_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="34dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/nothingui_device_wifi"
                android:textColor="#F2F2F2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nothingui_device_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/nothingui_device_pill_dark"
                android:clickable="true"
                android:fontFamily="@font/doto_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="34dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/nothingui_device_sound"
                android:textColor="#F2F2F2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nothingui_device_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/nothingui_device_pill_dark"
                android:clickable="true"
                android:fontFamily="@font/doto_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="34dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/nothingui_device_display"
                android:textColor="#F2F2F2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
