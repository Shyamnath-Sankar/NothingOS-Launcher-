<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nothingui_weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!--
      The provider swaps this default rounded tile for the stored light/dark
      surface at runtime, so the tile matches the clock, battery and device
      widgets without depending on night resource qualifiers. ImageView is on
      the RemoteViews class whitelist; a bare View is not.
    -->
    <ImageView
        android:id="@+id/nothingui_weather_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nothingui_widget_tile_dark"
        android:importantForAccessibility="no" />

    <!--
      A single compact row so the same layout stays legible at 2x1 and 2x2.
      The temperature auto-sizes; the condition and as-of/status lines stack on
      the right. All text is provider text, never a drawn chart or an asset.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/nothingui_weather_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/doto_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/nothingui_weather_value_unknown"
            android:textColor="#F2F2F2"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.15"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nothingui_weather_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/doto_regular"
                android:letterSpacing="0.2"
                android:maxLines="1"
                android:text="@string/nothingui_weather_label"
                android:textColor="#B3B3B3"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/nothingui_weather_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:breakStrategy="simple"
                android:fontFamily="@font/doto_regular"
                android:maxLines="2"
                android:text="@string/nothingui_weather_state_not_connected_short"
                android:textColor="#F2F2F2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nothingui_weather_asof"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/doto_regular"
                android:maxLines="1"
                android:text="@string/nothingui_weather_state_not_connected"
                android:textColor="#B3B3B3"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
