<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_none"
    android:padding="4dp">

    <ImageView
        android:id="@+id/status_tile_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/status_tile_preview_description"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status_tile_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="@color/widget_ink"
        android:textSize="12sp" />

</FrameLayout>
