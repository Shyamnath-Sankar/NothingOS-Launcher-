<?xml version="1.0" encoding="utf-8"?>
<!--
  Play-channel manifest overlay for NothingUI.

  Removes every non-core permission and component listed in AGENTS.md section 7
  for the Play variant. github/nightly keep the inherited feature set.

  This file is wired as both the play product-flavor manifest and the
  lawnWithQuickstepPlay variant manifest. The variant manifest has the highest
  merge priority, which is required for tools:node="remove" to remove entries
  declared by the higher-priority lawn/withQuickstep flavor manifests.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Play compliance: non-core permissions (AGENTS.md section 7). -->
    <uses-permission
        android:name="android.permission.READ_CONTACTS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_HISTORY_BOOKMARKS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_USERS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_USERS_FULL"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.MANAGE_USERS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FORCE_STOP_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.STATUS_BAR_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SUSPEND_APPS"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.apps.nexuslauncher.permission.QSB"
        tools:node="remove" />
    <uses-permission
        android:name="com.kieronquinn.app.smartspacer.permission.ACCESS_SMARTSPACER"
        tools:node="remove" />

    <!--
      Play compliance: Android 15+ private space (AGENTS.md section 7). This is
      what lets the launcher discover the hidden private profile and render its
      container. Locked profiles are filtered out of the drawer, search and
      recents; see AppSearchProvider/SearchUtils for the search filter.
    -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <!-- Keep the overrideLibrary marker needed by the Smartspacer SDK dependency. -->
    <uses-sdk tools:overrideLibrary="com.kieronquinn.app.smartspacer.sdk.client" />

    <application
        android:name="app.lawnchair.LawnchairApp"
        android:backupAgent="com.android.launcher3.LauncherBackupAgent"
        android:fullBackupOnly="true"
        android:fullBackupContent="@xml/backupscheme"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher_home"
        android:label="@string/play_app_name"
        android:roundIcon="@mipmap/ic_launcher_home_round"
        android:theme="@style/AppTheme"
        android:largeHeap="@bool/config_largeHeap"
        android:restoreAnyVersion="true"
        android:supportsRtl="true"
        tools:replace="android:label,android:icon">

        <!-- Launcher activity, inherited from quickstep/AndroidManifest-launcher.xml. -->
        <activity
            android:name="app.lawnchair.LawnchairLauncher"
            android:label="@string/play_app_name"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan"
            android:screenOrientation="unspecified"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.SHOW_WORK_APPS" />
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="com.android.launcher3.grid.control"
                android:value="${applicationId}.grid_control" />
        </activity>

        <!--
          Play-only discoverability: surface the existing preferences dashboard as
          a normal app-drawer entry. This adds only MAIN/LAUNCHER; HOME resolution
          stays on the launcher activity above, and the activity keeps its
          APPLICATION_PREFERENCES and lawnchair://settings filters from lawnchair/.
        -->
        <activity
            android:name="app.lawnchair.ui.preferences.PreferenceActivity"
            android:label="@string/play_settings_label"
            tools:replace="android:label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Play compliance: third-party QSB / Smartspacer components. -->
        <activity
            android:name="app.lawnchair.smartspace.SmartspacePreferencesShortcut"
            tools:node="remove" />
        <receiver
            android:name="app.lawnchair.smartspace.SmartspaceAppWidgetProvider"
            tools:node="remove" />

        <!--
          Play compliance: no AccessibilityService in v1 (AGENTS.md section 7).
          The class stays compiled for the shared source set, but it is never
          declared, so it cannot be enabled or bound in the Play build.
        -->
        <service
            android:name="app.lawnchair.LawnchairAccessibilityService"
            tools:node="remove" />

        <!--
          Play compliance: remove the inherited bug-report subsystem
          (AGENTS.md section 7). UploaderService was removed in P1b; the
          FileProvider and BugReportReceiver would otherwise survive and leave
          the crash-notification upload path half-wired.
        -->
        <provider
            android:name="app.lawnchair.bugreport.FileProvider"
            tools:node="remove" />
        <receiver
            android:name="app.lawnchair.bugreport.BugReportReceiver"
            tools:node="remove" />
        <service
            android:name="app.lawnchair.bugreport.UploaderService"
            tools:node="remove" />

        <!--
          Original DotWel home widgets. Only these three providers are declared, and only in the
          Play overlay. They add no permission: the clock is a native TextClock, the battery reads
          the sticky BATTERY_CHANGED broadcast through the launcher's lifecycle receiver, and the
          device card reads only the app data volume with StatFs.
        -->
        <receiver
            android:name="app.dotwel.widgets.DotWelClockWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nothingui_clock_widget_info" />
        </receiver>

        <receiver
            android:name="app.dotwel.widgets.DotWelBatteryWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
                <action android:name="android.intent.action.POWER_CONNECTED" />
                <action android:name="android.intent.action.POWER_DISCONNECTED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nothingui_battery_widget_info" />
        </receiver>

        <receiver
            android:name="app.dotwel.widgets.DotWelDeviceWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nothingui_device_widget_info" />
        </receiver>

        <!--
          Original dot-field live wallpaper. Play-only and protected by the
          platform BIND_WALLPAPER permission; it adds no uses-permission and no
          wider access. The user reaches it only through the explicit live
          preview action in the AMOLED wallpaper settings, and the system
          preview/confirmation owns the actual selection.
        -->
        <service
            android:name="app.nothingui.wallpaper.DotFieldWallpaperService"
            android:label="@string/dotwel_live_wallpaper_label"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/dotwel_dot_field_wallpaper" />
        </service>
    </application>
</manifest>
