<!--
  Play-only default home icon factor. The inherited base icon is 65dp; 0.76 gives roughly 49dp,
  while any stored user factor still wins because this is only the preference default. The drawer
  factor is intentionally not overridden.
-->
<resources>
    <item name="config_default_home_icon_size_factor" type="dimen" format="float">0.76</item>
</resources>
